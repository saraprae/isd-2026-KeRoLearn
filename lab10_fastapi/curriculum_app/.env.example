CURRICULUM_APP_NAME=Curriculum Book Assistant
CURRICULUM_DB_PATH=work/lab8b_run/DSBA/nocoop/curriculum.db
CURRICULUM_OLLAMA_URL=http://127.0.0.1:11434
CURRICULUM_OLLAMA_MODEL=qwen3:4b
CURRICULUM_REQUEST_TIMEOUT=180
CURRICULUM_MAX_ROWS=100

# เปิด JSONL logs เมื่อแอปเริ่มทำงาน; เวลาแยกขั้นใน API ใช้ได้แม้ตั้ง false.
CURRICULUM_LOG_ENABLED=false
# Relative path อิงรากโปรเจกต์ หรือกำหนด absolute path ได้.
CURRICULUM_LOG_DIR=work

# เพิ่ม/แทนชื่อเรียกของแต่ละรหัสด้วย JSON; รหัสและชื่อเต็มอ่านจาก mapping/DB.
# CURRICULUM_PROGRAM_ALIASES={"IT":["ไอที"],"DSBA":["ดีเอสบีเอ","วิทยาการข้อมูล"]}
